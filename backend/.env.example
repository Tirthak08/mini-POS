# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB Atlas ----
# Paste the "Node.js driver" string from Atlas -> Connect.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F, : -> %3A)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=mini_pos

# Only needed if "npm run db:check" fails with "querySrv ECONNREFUSED".
# Some ISPs/VPNs/office networks refuse the DNS SRV queries that a
# mongodb+srv:// string requires. Run "npm run dns:check" to confirm.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# ---- Auth ----
# The server refuses to start signing tokens while this is short or still says
# "replace_with", so a forgotten secret fails loudly instead of quietly.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# ---- Super Admin ----
# PRD section 4 says "hardcoded"; kept in env instead so the credentials are not
# committed to git. Admin sign-in stays disabled while the password still reads
# "replace_me", rather than shipping a known password.
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=replace_me_too

# ---- Reports ----
# Timezone the day/month buckets are cut on. Sales rung up at 11pm IST must land
# on the same day the shop counts them, which UTC bucketing would get wrong.
REPORT_TIMEZONE=Asia/Kolkata

# Units at or below this count as "running low" in the reports and the Stock tab.
LOW_STOCK_THRESHOLD=5
